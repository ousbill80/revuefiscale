# Base — role applicatif, JAMAIS le superuser
# Dev (hôte) : localhost:5433 — Compose prod-like écrase vers db:5432 (voir docker-compose.yml)
DATABASE_URL=postgresql+psycopg://app_revue:changeme@localhost:5433/revue_fiscale

# Base — role de migration, utilise uniquement par make migrate / entrypoint Docker
DATABASE_URL_ADMIN=postgresql+psycopg://postgres:postgres@localhost:5433/revue_fiscale

# Mots de passe DB (Compose / entrypoint) — changer hors machine de dév
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=revue_fiscale
APP_DB_PASSWORD=changeme
# POSTGRES_HOST_PORT=5433
# API_HOST_PORT=8000
# MIGRATE_ON_START=1

# Session — obligatoire non vide si ENV≠dev
SECRET_KEY=changeme-en-production

# --- LLM multi-fournisseurs (extraction identité / conformité pièces) ---
# Jamais committer de vraies clés. Priorité vision : Moonshot ; texte : DeepSeek.
# Moonshot : clé au format sk-… (console platform.moonshot.ai / moonshot.cn).
MOONSHOT_API_KEY=
# Global (recommandé hors Chine) : https://api.moonshot.ai/v1
# Chine : https://api.moonshot.cn/v1
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# Modèles internationaux courants : kimi-k3 (vision native), kimi-k2.6, …
# Anciens moonshot-v1-*-vision-preview : surtout plateforme CN.
MOONSHOT_MODEL=kimi-k3
MOONSHOT_MODEL_VISION=kimi-k3
# kimi-k3 thinking : low | high | max (défaut API = max ; identité structurée → low)
MOONSHOT_REASONING_EFFORT=low

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat (alias) ou deepseek-v4-flash / deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-chat

# Ordres de failover (ids : moonshot, deepseek, legacy)
LLM_PROVIDER_ORDER=moonshot,deepseek
LLM_VISION_ORDER=moonshot,deepseek,legacy
LLM_TEXT_ORDER=deepseek,moonshot,legacy
LLM_TIMEOUT_SECONDS=90
# Vision DFE : timeout + rasterisation JPEG (latence) — max 3 p. / 140 dpi
LLM_VISION_TIMEOUT_SECONDS=180
LLM_VISION_PDF_MAX_PAGES=3
LLM_VISION_PDF_DPI=140
LLM_VISION_JPEG_QUALITY=82

# Sessions upload pièces sans fiche client — purge TTL (heures, défaut 72)
PIECES_SESSION_TTL_HOURS=72

# Fallback mono-fournisseur OpenAI-compatible (legacy)
MODELE_FOURNISSEUR=
MODELE_CLE_API=
MODELE_NOM=

# Environnement — dev = make dev ; prod = docker compose (forcé aussi dans compose)
ENV=dev

# Provisionnement public POST /api/v1/provisionnement
# Autorise automatiquement si ENV=dev. Hors dev : mettre true seulement en secours.
# Creation abonne normale = Admin billing (/billing) — docs/11-saas-surfaces.md
ALLOW_PUBLIC_PROVISIONING=false

# Resend — OTP inscription self-service (https://resend.com)
# Domaine à vérifier sur Resend, puis :
RESEND_API_KEY=
RESEND_FROM=Revue Fiscale <revuefiscal@erparchipro.com>

# Paystack — paiement abonnement commercial (Visa + Mobile Money CI)
# Ops 2AàZ : https://dashboard.paystack.com → Settings → API Keys & Webhooks
# Webhook URL : POST {APP_PUBLIC_URL}/api/v1/webhooks/paystack  (event charge.success)
# Sans PAYSTACK_SECRET_KEY : payer-paystack → 503, UI désactivée (virement reste dispo).
# XOF = zero-decimal : amount = int(facture.montant), jamais *100.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optionnel — défaut : {APP_PUBLIC_URL}/app/?vue=facturation&paystack=1
PAYSTACK_CALLBACK_URL=
APP_PUBLIC_URL=http://localhost:8000

# Mentions légales facture commerciale (PDF billing)
# Laisser À CONFIRMER / vide tant que 2AàZ n'a pas fourni les vraies valeurs.
# Ne jamais inventer un RCCM / IDU « officiel ».
FACTURE_RAISON_SOCIALE=2AàZ SAS — À CONFIRMER
FACTURE_SIEGE=À CONFIRMER
# Alias accepté (faute fréquente) — prioritaire s'il est non vide :
# FACTURE_SIEDGE=
FACTURE_RCCM=À CONFIRMER
FACTURE_IDU=À CONFIRMER
FACTURE_COMPTE_BANCAIRE=À CONFIRMER
FACTURE_REGIME_TVA=A_CONFIRMER
FACTURE_TAUX_TVA=À CONFIRMER

# Compte staff demo (seed migration 005) — local uniquement, jamais en prod
# Email : billing@2aaz.ci
BILLING_DEMO_PASSWORD=BillingDemo2026!

# Staff editorial / ops (seed migration 006) — local uniquement
# editorial@2aaz.ci / EditorialDemo2026!
# ops@2aaz.ci / OpsDemo2026!

# Compte cabinet démo (/app) — créé via make demolot (ENV=dev uniquement)
# ou chip « Remplir Cabinet » / « Connexion démo » sur localhost.
# Email : admin@demo.local
# Mot de passe : demo-demo1
# Rejouer : make seed && make demolot
# (pas de seed SQL fixe — le tenant est provisionné à la demande)
CABINET_DEMO_EMAIL=admin@demo.local
CABINET_DEMO_PASSWORD=demo-demo1
